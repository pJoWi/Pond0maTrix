# ---- RPC (Helius recommended) ----
# Paste your own key. Never commit .env.
HELIUS_API_KEY=
# Optional full override. If empty, built from HELIUS_API_KEY, else falls back to public mainnet RPC.
RPC_URL=

# ---- Scanner ----
SCAN_INTERVAL_SEC=30          # TRiX poll interval
ENRICH_INTERVAL_SEC=120       # how often to refresh DexScreener/RugCheck per tracked token
TRACK_MAX_AGE_HOURS=72        # stop enriching tokens older than this (still shown in DB)
ALERT_SCORE_MIN=65            # score threshold for a SCORE_PASS alert
MCAP_MIN_USD=5000             # ignore tokens below (dust / test tokens)
MCAP_MAX_USD=250000           # the "early" window you want to be alerted in
LIQ_MIN_USD=8000              # bonded tokens with less liquidity than this get penalised

# ---- Dashboard ----
PORT=8787

# ---- Optional generic webhook for alerts (Discord/Slack/n8n...). Leave empty to disable. ----
ALERT_WEBHOOK_URL=

# ---- Manual trading CLI (only needed for `npm run cli -- buy ...`) ----
# Base58-encoded secret key of a DEDICATED hot wallet with a small balance. Not your main wallet.
WALLET_SECRET=
# Jupiter Swap API. Free lite endpoint by default; set JUPITER_API_KEY if you use api.jup.ag.
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=
SLIPPAGE_BPS=300              # 3% — memecoins with thin liquidity need room
PRIORITY_FEE_LAMPORTS=200000  # ~0.0002 SOL priority fee
